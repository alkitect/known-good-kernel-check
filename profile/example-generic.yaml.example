# Minimal public-shaped profile — copy and fill for your host.
# Empty pci/modules/packs are OK; checks skip or warn when nothing is configured.
# See docs/PUBLIC-ROADMAP.md and docs/CONTRACT.md.

profile_id: example-generic
schema_version: "1.0"
hold_on_any_warn: true

kernel_version: "REPLACE_WITH_UNAME_R"

promotion_allowed_warns: []

signatures:
  packs: []
  # Optional vendor packs later: amdgpu-display-type1, amdgpu-reset-mode1, …
  type1_path: signatures/amdgpu-type1.txt

reject_on_drift: []

pci: []

modules: []

kfd:
  require_dev_kfd: false

plugins: []

drm:
  min_cards: 0

wifi:
  iface: ""
  ethernet_fallback: true
  required: false

bluetooth:
  required_hci: ""
  required_state: UP
  expected: []

soak:
  mode: gate
  settle_seconds: 30
  gap_seconds: 10
  post_load_poll_seconds: 30
  default_seconds: 180
  load:
    enabled: false
    missing: warn
    cycles: 1
    window_seconds: 60
    recipe: none
    fail_on_signature_packs: []
  samples:
    enabled: false
  cadence:
    recommend: login
    min_runs_for_pre_unhold: 1
    min_pass_runs_for_pre_unhold: 1
    max_runs_for_campaign: 7
    max_login_soaks_per_day: 1  # with max_runs=7 ⇒ ≥7 local days
    min_source_login: 0
    min_calendar_days: 7
    prefer_passes_for_confidence: 3
    prefer_calendar_days: 2
    high_passes_for_confidence: 5
    high_calendar_days: 3

inventory_keys:
  - os_pretty
  - lockdown
